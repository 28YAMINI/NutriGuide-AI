# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=nutriguide
MYSQL_USER=nutriguide
MYSQL_PASSWORD=change-me-db-password
MYSQL_HOST_PORT=3307

# ===== Host ports =====
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=80

# ===== Backend =====
# Gemini API key - use the exact env var name your application.yml reads
GEMINI_API_KEY=

# JWT secret - only add this if your application.yml reads it from an env var
# (e.g. app.jwt.secret: ${JWT_SECRET:...}); otherwise leave it to application.yml
#JWT_SECRET=change-me-jwt-secret

# ===== Email (SMTP) =====
APP_MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# ===== URLs used in verification/reset links =====
APP_BASE_URL=http://localhost
FRONTEND_URL=http://localhost

# ===== Timezone =====
TZ=Asia/Kolkata