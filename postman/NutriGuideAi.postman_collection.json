{
  "info": {
    "name": "NutriGuide AI",
    "description": "Postman collection for the NutriGuide AI Spring Boot backend (Auth, Users, Foods). Generated from the actual controllers, DTOs, SecurityConfig and GlobalExceptionHandler. Run order: 1) Authentication (Register, Login, Login Admin) 2) Users 3) Foods - Public 4) Foods - Admin (Create Food first so foodId is captured) 5) Authorization Tests. JWT tokens and ids are captured automatically after login and food creation. Every error response from this backend has the shape { timestamp, status, error, message, path }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Public endpoints. 'Register' creates the USER and captures userId. 'Login (User)' captures the JWT into the 'token' variable. 'Login (Admin)' captures the admin JWT into 'adminToken' (the ADMIN account must be seeded in the database first).",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains message and user profile\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"message\");",
                  "  pm.expect(json).to.have.property(\"user\");",
                  "  pm.expect(json.user).to.have.property(\"id\");",
                  "  pm.expect(json.user).to.have.property(\"email\", pm.environment.get(\"userEmail\"));",
                  "  pm.expect(json.user).to.have.property(\"role\", \"USER\");",
                  "  pm.expect(json.user).to.not.have.property(\"password\");",
                  "});",
                  "",
                  "pm.test(\"Capture userId\", function () {",
                  "  const json = pm.response.json();",
                  "  if (json.user && json.user.id) {",
                  "    pm.environment.set(\"userId\", String(json.user.id));",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"age\": 25,\n  \"gender\": \"FEMALE\",\n  \"height\": 163,\n  \"weight\": 58,\n  \"activityLevel\": \"ACTIVE\",\n  \"goal\": \"LOSE_WEIGHT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"JWT token is present in the response\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"token\");",
                  "  pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(json).to.have.property(\"tokenType\", \"Bearer\");",
                  "  pm.expect(json).to.have.property(\"user\");",
                  "});",
                  "",
                  "pm.test(\"Save JWT token, user email and userId\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set(\"token\", json.token);",
                  "  if (json.user && json.user.email) {",
                  "    pm.environment.set(\"userEmail\", json.user.email);",
                  "  }",
                  "  if (json.user && json.user.id) {",
                  "    pm.environment.set(\"userId\", String(json.user.id));",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"JWT token is present in the response\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"token\");",
                  "  pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Save admin JWT token\", function () {",
                  "  pm.environment.set(\"adminToken\", pm.response.json().token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
