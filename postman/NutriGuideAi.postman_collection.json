            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Food contains the expected fields\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"id\");",
                  "  pm.expect(json).to.have.property(\"name\");",
                  "  pm.expect(json).to.have.property(\"category\");",
                  "  pm.expect(json).to.have.property(\"calories\");",
                  "  pm.expect(json).to.have.property(\"servingSize\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods",
                "{{foodId}}"
              ]
            }
          }
        },
        {
          "name": "Search Foods",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods/search?name={{searchName}}",
              "host": [
                "{{baseUrl}}"
