          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods",
                "{{foodId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Authorization Tests",
      "description": "Verifies the backend security rules: unauthenticated requests get 401, a regular USER calling an ADMIN-only endpoint gets 403. All error responses use the standard shape { timestamp, status, error, message, path }.",
      "item": [
        {
          "name": "Request Without Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"ErrorResponse has all 5 fields\", function () {",
                  "  const body = pm.response.json();",
                  "  [\"timestamp\", \"status\", \"error\", \"message\", \"path\"].forEach(function (field) {",
                  "    pm.expect(body).to.have.property(field);",
                  "  });",
                  "  pm.expect(body.status).to.eql(401);",
                  "  pm.expect(body.error).to.eql(\"Unauthorized\");",
                  "  pm.expect(body.message).to.eql(\"Authentication is required.\");",
                  "  pm.expect(body.path).to.eql(\"/api/users/me\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Invalid Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 Unauthorized\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"ErrorResponse has all 5 fields\", function () {",
                  "  const body = pm.response.json();",
                  "  [\"timestamp\", \"status\", \"error\", \"message\", \"path\"].forEach(function (field) {",
                  "    pm.expect(body).to.have.property(field);",
                  "  });",
                  "  pm.expect(body.status).to.eql(401);",
                  "  pm.expect(body.error).to.eql(\"Unauthorized\");",
                  "  pm.expect(body.message).to.eql(\"Authentication is required.\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid-token-123",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "USER Trying Admin Operation",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const token = pm.environment.get(\"token\");",
                  "if (!token) {",
                  "  throw new Error(\"token is not set. Run 'Login (User)' in the Authentication folder first.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 403 Forbidden\", function () {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"ErrorResponse has all 5 fields\", function () {",
                  "  const body = pm.response.json();",
                  "  [\"timestamp\", \"status\", \"error\", \"message\", \"path\"].forEach(function (field) {",
                  "    pm.expect(body).to.have.property(field);",
                  "  });",
                  "  pm.expect(body.status).to.eql(403);",
                  "  pm.expect(body.error).to.eql(\"Forbidden\");",
                  "  pm.expect(body.message).to.eql(\"You do not have permission to access this resource.\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orange\",\n  \"description\": \"Fresh orange\",\n  \"category\": \"FRUITS\",\n  \"calories\": 47,\n  \"protein\": 0.9,\n  \"carbohydrates\": 11.8,\n  \"fat\": 0.1,\n  \"fiber\": 2.4,\n  \"servingSize\": \"100g\",\n  \"imageUrl\": \"https://example.com/orange.jpg\",\n  \"vegetarian\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          }
        }
      ]
    }
  ]
