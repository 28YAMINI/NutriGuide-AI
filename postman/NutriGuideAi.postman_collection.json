    {
      "name": "Foods - Admin",
      "description": "Write endpoints. POST/PUT/DELETE /api/foods/** require the ADMIN role (Bearer {{adminToken}}). A regular USER gets 403.",
      "item": [
        {
          "name": "Create Food",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const adminToken = pm.environment.get(\"adminToken\");",
                  "if (!adminToken) {",
                  "  throw new Error(\"adminToken is not set. Run 'Login (Admin)' in the Authentication folder first, and make sure the ADMIN account is seeded in the database.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Food is created with the expected fields\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"id\");",
                  "  pm.expect(json).to.have.property(\"name\", \"Apple\");",
                  "  pm.expect(json).to.have.property(\"category\", \"FRUITS\");",
                  "  pm.expect(json).to.have.property(\"calories\", 52);",
                  "  pm.expect(json).to.have.property(\"vegetarian\", true);",
                  "});",
                  "",
                  "pm.test(\"Capture foodId\", function () {",
                  "  const json = pm.response.json();",
                  "  if (json.id) {",
                  "    pm.environment.set(\"foodId\", String(json.id));",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apple\",\n  \"description\": \"Fresh red apple\",\n  \"category\": \"FRUITS\",\n  \"calories\": 52,\n  \"protein\": 0.3,\n  \"carbohydrates\": 14,\n  \"fat\": 0.2,\n  \"fiber\": 2.4,\n  \"servingSize\": \"100g\",\n  \"imageUrl\": \"https://example.com/apple.jpg\",\n  \"vegetarian\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods"
              ]
            }
          }
        },
        {
          "name": "Update Food",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const foodId = pm.environment.get(\"foodId\");",
                  "const adminToken = pm.environment.get(\"adminToken\");",
                  "if (!foodId) {",
                  "  throw new Error(\"foodId is not set. Run 'Create Food' in the Foods - Admin folder first.\");",
                  "}",
                  "if (!adminToken) {",
                  "  throw new Error(\"adminToken is not set. Run 'Login (Admin)' in the Authentication folder first.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Updated food is returned\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"id\", Number(pm.environment.get(\"foodId\")));",
                  "  pm.expect(json).to.have.property(\"name\", \"Apple\");",
                  "  pm.expect(json).to.have.property(\"category\", \"FRUITS\");",
                  "  pm.expect(json).to.have.property(\"calories\", 52);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apple\",\n  \"description\": \"Fresh red apple (updated)\",\n  \"category\": \"FRUITS\",\n  \"calories\": 52,\n  \"protein\": 0.3,\n  \"carbohydrates\": 14,\n  \"fat\": 0.2,\n  \"fiber\": 2.4,\n  \"servingSize\": \"100g\",\n  \"imageUrl\": \"https://example.com/apple.jpg\",\n  \"vegetarian\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/foods/{{foodId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "foods",
                "{{foodId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Food",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const foodId = pm.environment.get(\"foodId\");",
                  "const adminToken = pm.environment.get(\"adminToken\");",
                  "if (!foodId) {",
                  "  throw new Error(\"foodId is not set. Run 'Create Food' in the Foods - Admin folder first.\");",
                  "}",
                  "if (!adminToken) {",
                  "  throw new Error(\"adminToken is not set. Run 'Login (Admin)' in the Authentication folder first.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
